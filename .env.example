# Copy to .env and fill in. Never commit .env or key files.

# ---------------------------------------------------------------- Phase 1: corpus analysis (one-time)
# Google Drive folder holding the source PDFs. Share it with the service account's email.
URT_DRIVE_FOLDER_ID=
# Path to the service-account JSON key (stored outside the repo).
GOOGLE_APPLICATION_CREDENTIALS=
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Alternative to GEMINI_API_KEY: an OpenAI-compatible gateway (chat completions).
# URT_CA_LLM_PROVIDER=openai                # default: gemini
# URT_CA_OPENAI_BASE_URL=https://…/v1
# URT_CA_OPENAI_API_KEY=

# Optional (defaults shown)
# URT_CA_DATA_DIR=data/corpus_analysis      # gitignored working directory
# URT_CA_MODEL_EXTRACT=gemini-3.8-flash     # OCR, segmentation fallback, per-passage analysis
# URT_CA_MODEL_SYNTHESIS=gemini-4-argon     # Step B rule synthesis
# URT_CA_MAX_COST_USD=5                     # hard stop; the run halts before exceeding it
# URT_CA_PRICES_FILE=tools/corpus_analysis/prices.yaml
# URT_CA_RPM=30                             # max LLM requests per minute
# URT_CA_CONCURRENCY=2                      # parallel analysis calls
# URT_CA_MAX_LLM_RETRIES=3                  # schema-invalid retries before dead-lettering
# URT_CA_REQUEST_TIMEOUT_S=180
# URT_CA_THINKING_LEVEL=low                 # set empty to omit the thinking setting
# URT_CA_OCR_MIN_CHARS=120                  # pages with less text than this (and images) are OCR'd
# URT_CA_IMAGE_TOKENS=1100                  # per-image token estimate used for budget reservations
# URT_CA_SEGMENT_CONFIDENCE=0.7             # below this, a file is re-segmented by Gemini
# URT_CA_SEGMENT_WINDOW_PAGES=6
# URT_CA_MODEL_EMBEDDING=text-embedding-3-small   # fingerprints; must match the runtime's URT_MODEL_EMBEDDING

# ---------------------------------------------------------------- Runtime (server/services/urt, see config.js)
URT_OPENAI_BASE_URL=
URT_OPENAI_API_KEY=
# URT_MODEL_GENERATION=gemini-3.8-flash
# URT_MODEL_VALIDATION=gemini-2.5-flash        # must differ from the generation model
# URT_MODEL_FEEDBACK=gemini-2.5-flash-lite
# URT_MODEL_PRICES={"model": {"input": 0.0, "output": 0.0}}   # US$ per 1M tokens; merged over the defaults
# URT_MAX_GENERATION_ATTEMPTS=3
# URT_ALLOW_DRAFT_RULES=false
# URT_NEW_STUDENTS_GET_FRESH=true               # OPEN-1: false = reuse stored passages for new students too
# URT_FRESH_BUFFER_LOW=5  URT_FRESH_BUFFER_TARGET=15  URT_DAILY_COST_CAP_USD=5  URT_MAX_CONCURRENT_GENERATIONS=2

# ---------------------------------------------------------------- Runtime originality check (from Phase 1 calibration)
# URT_MODEL_EMBEDDING=text-embedding-3-small
# URT_EMBEDDING_DIMS=1536
# URT_MAX_CORPUS_JACCARD=0.2
# URT_MAX_CORPUS_COSINE=0.85
# URT_MAX_POOL_COSINE=0.85
